{
  "name": "aws-favorites-quickbar",
  "version": "1.4.1",
  "description": "Chrome extension to populate AWS Console favorites bar",
  "author": "8its.pixel@gmail.com",
  "scripts": {
    "clean": "make clean",
    "compile": "tsc",
    "bundle": "tsx scripts/bundle.ts",
    "bundle:prod": "NODE_ENV=production tsx scripts/bundle.ts",
    "build:chrome": "make build-chrome",
    "build:firefox": "make build-firefox",
    "build:all": "make build-all",
    "watch": "make watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "vitest run --reporter=verbose",
    "test:e2e": "make build-chrome && playwright test",
    "test:e2e:login": "make build-chrome && tsx scripts/e2e-login.ts",
    "test:e2e:ui": "make build-chrome && playwright test --ui",
    "preview:firefox": "make build-firefox && open -a Firefox \"file://$(pwd)/dist/firefox/popup.html\"",
    "run:firefox": "make build-firefox && npx web-ext run --source-dir dist/firefox",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.mjs\"",
    "type-check": "tsc --noEmit",
    "audit": "npm audit",
    "check:unused": "npx ts-prune",
    "check:circular": "npx madge --circular --extensions ts src/",
    "check:all": "npm run type-check && npm run lint && npm run format:check && npm test",
    "security-check": "tsx scripts/security-check.ts",
    "version:bump": "tsx scripts/bump-version.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
